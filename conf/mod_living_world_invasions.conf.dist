# Living World Invasions

LWI.Enable = 1
LWI.Playerbots.Enable = 0
LWI.Debug = 1

# Scheduler timing settings. Development defaults are intentionally short for observation/testing.
LWI.Scheduler.Enable = 1
LWI.Scheduler.CheckIntervalSeconds = 5
LWI.Scheduler.InitialDelayMinSeconds = 20
LWI.Scheduler.InitialDelayMaxSeconds = 40
LWI.Scheduler.NextDelayMinSeconds = 30
LWI.Scheduler.NextDelayMaxSeconds = 60

# A value of 0 means unlimited.
LWI.Scheduler.MaxActiveGlobal = 3
LWI.Scheduler.DefaultMaxActivePerMap = 2
LWI.Scheduler.DefaultMaxActivePerResponseOrigin = 1

# Dynamic overrides support any standard or custom map/response-origin ID.
LWI.Scheduler.MaxActive.Map.0 = 2
LWI.Scheduler.MaxActive.ResponseOrigin.1 = 1
LWI.Scheduler.MaxActive.ResponseOrigin.2 = 1